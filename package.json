{
  "name": "scorebreak-website",
  "private": true,
  "description": "ScoreBreak marketing site, built with Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:staging": "scripts/deploy.sh staging",
    "deploy:production": "scripts/deploy.sh production",
    "check": "astro check",
    "test": "npm run check && npm run build && npm run test:static && npm run test:browser",
    "test:static": "node --test tests/static.test.mjs",
    "test:browser": "playwright test",
    "snapshot:save": "node tests/style-snapshot.mjs save",
    "snapshot:compare": "node tests/style-snapshot.mjs compare"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.64.1",
    "astro": "^7.4.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4"
  }
}

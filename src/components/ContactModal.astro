<div class="sb-modal-backdrop" id="sbContactModal" data-modal role="dialog" aria-modal="true" aria-labelledby="sbModalTitle">
  <div class="sb-modal">
    <button class="sb-modal-close" data-modal-close aria-label="Close">✕</button>
    <h2 id="sbModalTitle">Get in Touch</h2>
    <p class="sb-modal-sub">Have questions? We're happy to help, no commitment required.</p>

    <div id="sbModalFormWrap">
      <form id="sbContactForm" name="contact-sales" method="POST" data-form="contact-sales" data-form-hide="#sbModalFormWrap" data-form-confirm="#sbModalConfirm">
        <p class="sb-hidden-field"><label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

        <div class="sb-form-row">
          <div class="sb-form-group">
            <label for="sbFirstName">First Name</label>
            <input type="text" id="sbFirstName" name="firstName" required>
          </div>
          <div class="sb-form-group">
            <label for="sbLastName">Last Name</label>
            <input type="text" id="sbLastName" name="lastName" required>
          </div>
        </div>
        <div class="sb-form-group">
          <label for="sbEmail">Email</label>
          <input type="email" id="sbEmail" name="email" required>
        </div>
        <div class="sb-form-group">
          <label for="sbMessage">Message</label>
          <textarea id="sbMessage" name="message" rows="4" placeholder="Tell us about your program and what you're looking for..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary sb-form-submit">Send Message</button>
      </form>

      <div class="sb-modal-divider"><span>or</span></div>

      <div class="sb-modal-options">
        <a href="/demo/" class="sb-modal-option">
          <div class="sb-modal-option-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <div>
            <div class="sb-modal-option-label">Request a Demo</div>
            <div class="sb-modal-option-detail">See the full platform in a 20-minute walkthrough.</div>
          </div>
        </a>
      </div>

      <p class="sb-modal-phone">Or call us: <a href="tel:18008092102">1.800.809.2102</a></p>
    </div>

    <div id="sbModalConfirm" class="sb-modal-confirm" hidden>
      <div class="sb-modal-confirm-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
      </div>
      <p id="sbModalConfirmText">Thanks <span data-field="firstName"></span>, we'll be in touch shortly.</p>
    </div>
  </div>
</div>

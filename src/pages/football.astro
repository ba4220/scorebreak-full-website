            <path d="M9 5V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h2"/>
          </svg>
          Copy
        </button>
      </div>
    </div>

    <div class="referral-perks-list">
      <div class="referral-perk-item">
        <svg class="perk-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 8l4 4 9-9"/>
        </svg>
        <span>Each coach you refer <strong style="color:var(--white)">moves you up</strong> the early access list.</span>
      </div>
      <div class="referral-perk-item">
        <svg class="perk-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 8l4 4 9-9"/>
        </svg>
        <span>Coaches with enough referrals receive a <strong style="color:var(--white)">discount on their first year</strong>.</span>
      </div>
      <div class="referral-perk-item">
        <svg class="perk-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 8l4 4 9-9"/>
        </svg>
        <span>Your referrals also get priority access  -  <strong style="color:var(--white)">everyone wins</strong>.</span>
      </div>
    </div>

    <button class="confirm-close" id="confirm-close-btn" data-modal-close>Close and return to page</button>
  </div>
</div>

<script>import '../scripts/waitlist';</script>
</Layout>

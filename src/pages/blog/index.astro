---
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate, isoDate } from '../../lib/blog';

const posts = await getPosts();

const seo = {
  title: 'Blog | ScoreBreak',
  description: 'Updates, announcements, and insights from the ScoreBreak team.',
  twitterTitle: 'Blog | ScoreBreak',
  twitterDescription: 'Updates, announcements, and insights from the ScoreBreak team.',
};
---
<Layout seo={seo}>
<Fragment slot="head">
  <style is:inline>
    /* ── Hero ── */
    .blog-hero {
      padding: calc(var(--nav-h) + 4.5rem) 0 3rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .blog-hero .section-label { font-size: .9rem; }
    .blog-hero h1 {
      font-size: clamp(2rem, 4.5vw, 3.4rem);
      font-weight: 900;
      letter-spacing: -.04em;
      line-height: 1.12;
      margin: 1rem auto 1.25rem;
      position: relative;
    }
    .blog-hero-sub {
      font-size: 1.05rem;
      color: var(--text-muted);
      line-height: 1.75;
      max-width: 560px;
      margin: 0 auto;
      position: relative;
    }

    /* ── Post list ── */
    .post-list { max-width: 760px; margin: 0 auto; }
    .post-entry { padding: 2rem 0; border-top: 1px solid var(--border-sub); }
    .post-entry:last-child { border-bottom: 1px solid var(--border-sub); }
    .post-entry-meta {
      font-size: .75rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: .6rem;
    }
    .post-entry h2 {
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -.02em;
      line-height: 1.3;
      margin-bottom: .6rem;
    }
    .post-entry h2 a { transition: color .2s; }
    .post-entry h2 a:hover { color: var(--blue); }
    .post-entry-excerpt {
      font-size: .98rem;
      color: var(--text-muted);
      line-height: 1.7;
    }

    @media (max-width: 600px) {
      .blog-hero h1 { font-size: clamp(1.9rem, 8vw, 2.6rem); }
      .post-entry h2 { font-size: 1.25rem; }
    }
  </style>
</Fragment>

<section class="blog-hero">
  <div class="container">
    <div class="section-label">Blog</div>
    <h1>Make the Change.</h1>
    <p class="blog-hero-sub">Updates, announcements, and insights from the ScoreBreak team.</p>
  </div>
</section>

<!-- ══════════════════════════════════════
     POSTS
══════════════════════════════════════ -->
<section class="section" style="padding-top:1rem;">
  <div class="container">
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-entry">
          <div class="post-entry-meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time> <span aria-hidden="true">&middot;</span> {post.data.author}</div>
          <h2><a href={`${post.id}.html`}>{post.data.title}</a></h2>
          <p class="post-entry-excerpt">{post.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

</Layout>

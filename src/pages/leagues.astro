---
import { Image } from 'astro:assets';
import leagueExchangeImg from '../assets/software/league-exchange.png';
import liljImg from '../assets/ncaa-d1/lilj.png';
import leagueSiteMockupImg from '../assets/league-site-mockup.png';
import nbaAcademyLogoImg from '../assets/ncaa-d1/nba-academy-logo.png';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';

const seo = {
  title: 'ScoreBreak League Solutions | Platform for Leagues and Federations',
  description: 'ScoreBreak gives leagues and federations the infrastructure to standardize film, stream game day operations, and create a professional experience  -  from public stats sites to officiating replay and film exchange.',
  keywords: 'lacrosse league platform, sports federation software, league stats site, film exchange platform, officiating replay, league management software, ScoreBreak leagues',
  ogDescription: 'From film exchange to public stats sites  -  ScoreBreak gives leagues and federations the infrastructure to standardize film, streamline game day operations, and create a professional experience.',
  twitterTitle: 'ScoreBreak League Solutions | Platform for Leagues and Federations',
  twitterDescription: 'From film exchange to public stats sites  -  ScoreBreak gives leagues and federations the infrastructure they need.',
};
---
<Layout seo={seo}>

<section class="lg-hero">
  <div class="container">
    <div class="lg-hero-badge">
      League Solutions
    </div>
    <h1>An All-in-One Platform for<br><span>Leagues and Federations.</span></h1>
    <p class="lg-hero-sub">From film exchange to public stats sites  -  ScoreBreak gives leagues and federations the infrastructure to standardize film, streamline game day operations, and create a professional experience for administrators, coaches, officials, and scouts alike.</p>
    <div class="hero-actions hero-actions--center">
      <a href="#" class="btn btn-primary btn-lg" data-modal-open="sbContactModal">Contact Us</a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     WHO IT'S FOR
════════════════════════════════════════════════════════════ -->
<section class="section section-band">
  <div class="container">
    <div class="section-head">
      <span class="section-label">Built for Everyone in the League</span>
      <h2 class="section-title">Designed for every role on game day and beyond.</h2>
    </div>
    <div class="role-grid">

      <div class="role-card">
        <div class="role-eyebrow"><span class="role-eyebrow-dot"></span>League Administrators</div>
        <h3>One platform. Every team. Every game.</h3>
        <p>One platform to manage film, stats, schedules, and player data across every team in your league. Standardize the experience, reduce operational overhead, and give every team access to the same quality of tools.</p>
      </div>

      <div class="role-card">
        <div class="role-eyebrow"><span class="role-eyebrow-dot"></span>Coaching Staffs</div>
        <h3>Every game. Fully broken down. No extra work.</h3>
        <p>Every team in the league gets fully broken down film for every game  -  not just their own. Scout opponents, review your own performance, and prepare with professional-grade film without any extra work from your staff.</p>
      </div>

      <div class="role-card">
        <div class="role-eyebrow"><span class="role-eyebrow-dot"></span>Game Day Operations</div>
        <h3>From replay operators to officials.</h3>
        <p>ScoreBreak streamlines game day from every angle  -  Airborne Stadium delivers frame-accurate multi-angle replay for officiating review, and replay operators get a reliable system that integrates with your existing video infrastructure.</p>
      </div>

      <div class="role-card">
        <div class="role-eyebrow"><span class="role-eyebrow-dot"></span>Recruiting</div>
        <h3>Every game is a recruiting opportunity.</h3>
        <p>League stats sites are publicly accessible  -  college coaches and scouts can view standings, player profiles, stats, and watch the film behind the numbers. Every game in your league becomes a recruiting opportunity for every player.</p>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     FILM EXCHANGE
════════════════════════════════════════════════════════════ -->
<section class="section lg-exchange">
  <div class="container">
    <div class="lg-two-col lg-exchange-cols">
      <div class="lg-exchange-media">
        <Image src={leagueExchangeImg} width={702} alt="ScoreBreak Film Exchange  -  league-wide film access for every team" class="img-fluid" />
      </div>

      <div class="lg-section-text">
        <span class="section-label lg-label">Film Exchange</span>
        <h2>Every team in the league. On the same page.</h2>
        <p>ScoreBreak's Film Exchange gives leagues a centralized hub for video distribution. Whether teams use ScoreBreak or another platform, everyone stays connected to the same film.</p>

        <div class="lg-exchange-cards">

          <div class="lg-exchange-card">
            <strong>Universal Access</strong>
            <p>Teams using any platform can access and download league film through the Exchange. No ScoreBreak subscription required for exchange-only access.</p>
          </div>

          <div class="lg-exchange-card">
            <strong>Broken Down Film</strong>
            <p>ScoreBreak teams get fully broken down film  -  professionally tagged and statted via Handoff, or broken down by the teams themselves. All breakdowns flow into the same league hub.</p>
          </div>

          <div class="lg-exchange-card">
            <strong>Fully Standardized</strong>
            <p>When the whole league is on ScoreBreak, everyone works from the same film. Same breakdowns. One platform for scouting, prep, and review.</p>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     LEAGUE STATS SITES
════════════════════════════════════════════════════════════ -->
<section class="section section-band">
  <div class="container">
    <div class="lg-two-col reverse lg-two-col--center">
      <div class="lg-section-text">
        <span class="section-label lg-label">Public League Hub</span>
        <h2>An interactive stats site for your league.</h2>
        <div class="lg-checklist lg-checklist--spaced">
          <div class="lg-check-item">
            <div class="lg-check-icon"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span>Fully branded with your league's name and logo</span>
          </div>
          <div class="lg-check-item">
            <div class="lg-check-icon"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span>Live standings and schedules</span>
          </div>
          <div class="lg-check-item">
            <div class="lg-check-icon"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span>Individual and team statistics</span>
          </div>
          <div class="lg-check-item">
            <div class="lg-check-icon"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span>Player profiles with headshots, grad year, and position</span>
          </div>
          <div class="lg-check-item">
            <div class="lg-check-icon lg-check-icon--strong"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span class="lg-check-strong">Every stat linked to video  -  click any number, watch the play</span>
          </div>
          <div class="lg-check-item">
            <div class="lg-check-icon"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span>Stat leaders leaderboards</span>
          </div>
          <div class="lg-check-item">
            <div class="lg-check-icon"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6l3 3 5-5"/></svg></div>
            <span>Publicly accessible for fans, coaches, and scouts</span>
          </div>
        </div>

        <!-- LILJ Partnership card -->
        <a href="https://app.scorebreak.io/federation/239/main" target="_blank" rel="noopener" class="lg-partnership">
          <Image src={liljImg} width={44} alt="Long Island Lacrosse Journal" class="lg-quote-logo" />
          <div class="lg-partnership-divider"></div>
          <div>
            <p>In partnership with the Long Island Lacrosse Journal, explore a live sample of our league platform  -  powered by the Juniors Open.</p>
            <span>View the Juniors Open Stats Site →</span>
          </div>
        </a>
      </div>

      <!-- Mockup image -->
      <div class="lg-visual">
        <Image src={leagueSiteMockupImg} width={704} alt="ScoreBreak League Sites  -  branded league hub with live standings, stats, and film-linked video" />
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     OFFICIATING REPLAY
════════════════════════════════════════════════════════════ -->
<section class="section">
  <div class="container">
    <div class="lg-officiating">
      <span class="section-label lg-label">Officiating</span>
      <h2 class="section-title">Built-in officiating replay.</h2>
      <p class="lg-officiating-text">ScoreBreak Airborne Stadium integrates with your league's video infrastructure to provide frame-accurate officiating replay. Live stats from your statistics provider sync automatically with multiple camera angles, enabling synchronized multi-angle playback for officials in real time. Used at the highest levels of basketball and lacrosse.</p>
      <a href="/airborne/" class="btn btn-outline btn-lg">Learn About Airborne →</a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     API INTEGRATIONS
════════════════════════════════════════════════════════════ -->
<section class="section section-band">
  <div class="container">
    <div class="lg-two-col">
      <div class="lg-section-text">
        <span class="section-label lg-label">Integrations</span>
        <h2>Connect your existing infrastructure.</h2>
        <p class="lg-integrations-text">ScoreBreak integrates with your league's existing technology stack via API.</p>
      </div>
      <div class="lg-integrations">
        <div class="lg-integration">
          <div class="lg-integration-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div><div class="lg-integration-name">Statistics Provider</div><div class="lg-integration-desc">Live stat sync via API</div></div>
        </div>
        <div class="lg-integration">
          <div class="lg-integration-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M8 12h8M8 16h4"/></svg>
          </div>
          <div><div class="lg-integration-name">Scoring Systems</div><div class="lg-integration-desc">Live scores to standings automatically</div></div>
        </div>
        <div class="lg-integration">
          <div class="lg-integration-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
          </div>
          <div><div class="lg-integration-name">Video Platform</div><div class="lg-integration-desc">Stats and film linked automatically</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     TRUSTED BY
════════════════════════════════════════════════════════════ -->
<section class="section">
  <div class="container">
    <div class="section-head lg-head-flush">
      <span class="section-label">Trusted By</span>
      <h2 class="section-title">Powering leagues at every level.</h2>
    </div>
    <div class="trusted-row">

      <div class="trusted-badge">
        <Image src={liljImg} width={44} alt="Long Island Lacrosse Journal / Juniors Open" />
        <span class="trusted-badge-label">Juniors Open</span>
      </div>

      <div class="trusted-badge">
        <Image src={nbaAcademyLogoImg} width={151} alt="NBA Academy Games" />
        <span class="trusted-badge-label">NBA Academy Games</span>
      </div>

      <div class="trusted-more">and more</div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     CTA
════════════════════════════════════════════════════════════ -->
<CtaSection title="Bring ScoreBreak to your league." titleStyle="margin-bottom:2rem;" secondaryLabel="Request a Demo →" />

</Layout>

<style>

/* ── Hero ─────────────────────────────── */
.lg-hero {
  padding: calc(var(--nav-h) + 4.5rem) 0 4rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.lg-hero-badge {
  display: inline-block;
  font-size: .9rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 1.75rem;
}
.lg-hero h1 {
  font-size: clamp(2.4rem, 5vw, 4rem);
  font-weight: 900;
  letter-spacing: -.04em;
  line-height: 1.08;
  margin-bottom: 1.5rem;
  color: var(--text);
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
}
.lg-hero h1 span { color: var(--blue); }
.lg-hero-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.75;
  max-width: 680px;
  margin: 0 auto 2.5rem;
}

/* ── Role Cards ───────────────────────── */
.role-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
  align-items: stretch;
}
.role-card {
  background: var(--card-bg);
  border: 1px solid var(--border-sub);
  border-radius: var(--radius);
  padding: 2rem 1.75rem;
  transition: background .2s, border-color .2s;
  display: flex;
  flex-direction: column;
}
.role-card:hover {
  background: var(--card-bg2);
  border-color: var(--border);
}
.role-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: .75rem;
}
.role-eyebrow-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--blue);
  flex-shrink: 0;
}
.role-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: .6rem;
}
.role-card p {
  font-size: .9rem;
  color: var(--text-muted);
  line-height: 1.65;
}

/* ── Two-column feature layout ────────── */
.lg-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
.lg-two-col.reverse { direction: rtl; }
.lg-two-col.reverse > * { direction: ltr; }

/* ── Feature checklist ─────────────────── */
.lg-checklist {
  display: flex;
  flex-direction: column;
  gap: .55rem;
  margin-top: 1.75rem;
}
.lg-check-item {
  display: flex;
  align-items: flex-start;
  gap: .75rem;
  font-size: .9rem;
  color: var(--text-muted);
  line-height: 1.55;
}
.lg-check-icon {
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--blue-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: .1rem;
  color: var(--blue);
}
.lg-check-icon svg { width: 11px; height: 11px; }

/* ── Mockup image ──────────────────────── */
.lg-visual {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 30px 60px rgba(86,199,255,.15), 0 0 0 1px rgba(86,199,255,.1);
}
.lg-visual img {
  width: 100%;
  height: auto;
  display: block;
}

/* ── LILJ partnership card ─────────────── */
.lg-partnership {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 1.5rem;
  padding: 1.25rem 1.5rem;
  background: rgba(86,199,255,.05);
  border: 1px solid rgba(86,199,255,.15);
  border-radius: 12px;
  text-decoration: none;
  transition: background .2s, border-color .2s;
}
.lg-partnership:hover {
  background: rgba(86,199,255,.09);
  border-color: rgba(86,199,255,.28);
}
.lg-partnership-divider {
  width: 1px;
  align-self: stretch;
  background: rgba(86,199,255,.2);
  flex-shrink: 0;
}
.lg-partnership p {
  font-size: .8rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: .35rem;
}
.lg-partnership span {
  font-size: .8rem;
  font-weight: 600;
  color: var(--blue);
}

/* ── Trusted-by badges ─────────────────── */
.trusted-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2.5rem;
}
.trusted-badge {
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .75rem 1.25rem;
  background: var(--card-bg);
  border: 1px solid var(--border-sub);
  border-radius: 10px;
}
.trusted-badge img {
  height: 36px;
  width: auto;
  object-fit: contain;
}
.trusted-badge-label {
  font-size: .85rem;
  font-weight: 600;
  color: var(--text);
}
.trusted-more {
  font-size: .9rem;
  color: var(--text-muted);
  font-style: italic;
  padding: .75rem 1.25rem;
}

/* ── Officiating image box ─────────────── */
.lg-section-text h2 {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 800;
  letter-spacing: -.03em;
  line-height: 1.15;
  color: var(--text);
  margin-bottom: 1rem;
}
.lg-section-text p {
  font-size: .97rem;
  color: var(--text-muted);
  line-height: 1.75;
  margin-bottom: 1.5rem;
}

/* ── Film Exchange benefit cards ─────── */
.lg-exchange-cards {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  margin-top: 1.5rem;
}
.lg-exchange-card strong {
  display: block;
  font-size: .875rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: .3rem;
}
.lg-exchange-card p {
  font-size: .8125rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0;
}

/* ── Responsive ───────────────────────── */
@media (max-width: 900px) {
  .role-grid { grid-template-columns: 1fr; }
  .lg-two-col { grid-template-columns: 1fr !important; gap: 2.5rem; }
  .lg-two-col.reverse { direction: ltr; }
}
@media (max-width: 600px) {
  .lg-hero { padding-top: calc(var(--nav-h) + 3.5rem); padding-bottom: 4rem; }
  .lg-hero h1 { font-size: clamp(1.9rem, 8vw, 2.6rem); }
  .trusted-row { gap: .75rem; }
}

/* Formerly inline style="" attributes: last in the sheet so they still win over earlier rules. */
.lg-exchange {
  padding: 3.75rem 0;
}
.lg-exchange-cols {
  align-items: center;
  gap: 3.75rem;
  grid-template-columns: 1.2fr 1fr;
}
.lg-exchange-media {
  background: var(--card-bg);
  border: 1px solid var(--border-sub);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.lg-label {
  margin-bottom: 1rem;
  display: inline-block;
}
.lg-two-col--center {
  align-items: center;
}
.lg-checklist--spaced {
  margin-top: 1.25rem;
}
.lg-check-icon--strong {
  background: rgba(86,199,255,.15);
}
.lg-check-strong {
  color: var(--text);
  font-weight: 600;
}
.lg-quote-logo {
  height: 44px;
  width: auto;
  object-fit: contain;
  flex-shrink: 0;
}
.lg-officiating {
  max-width: 740px;
  margin: 0 auto;
  text-align: center;
}
.lg-officiating-text {
  font-size: 1rem;
  color: var(--text-muted);
  line-height: 1.75;
  margin-bottom: 2rem;
}
/* Beats .lg-section-text p, as the inline style did. */
.lg-section-text .lg-integrations-text {
  margin-bottom: 0;
  text-wrap: balance;
}
.lg-integrations {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  justify-content: center;
}
.lg-integration {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem;
  background: var(--card-bg2);
  border: 1px solid var(--border-sub);
  border-radius: 10px;
}
.lg-integration-icon {
  width: 44px;
  height: 44px;
  background: var(--blue-dim);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--blue);
}
.lg-integration-name {
  font-size: .85rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: .2rem;
}
.lg-integration-desc {
  font-size: .8rem;
  color: var(--text-muted);
}
.lg-head-flush {
  margin-bottom: 0;
}
</style>

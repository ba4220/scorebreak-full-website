---
import Layout from '../layouts/Layout.astro';
---
<Layout>
<Fragment slot="meta">
  <title>ScoreBreak | Film Analysis and Sideline Replay for Competitive Sports Programs</title>
  <meta name="description" content="Film analysis, live stats, and sideline replay for competitive sports programs. Custom tagging, AI reporting, and recruiting profiles for programs at every level.">
  <meta name="keywords" content="Hudl alternative, football film analysis software, lacrosse film analysis, sideline replay system, sports video analysis platform, high school coaching software, Recruiting Network for lacrosse, ScoreBreak, Airborne sideline replay">
  <meta property="og:title" content="ScoreBreak | Film Analysis, Sideline Replay &amp; Recruiting Platform">
  <meta property="og:description" content="Film analysis, live stats, and sideline replay for competitive sports programs. Custom tagging, AI reporting, and recruiting profiles for programs at every level.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://scorebreak.io">
  <meta property="og:image" content="https://scorebreak.io/logos/logo-nav.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="ScoreBreak | Film Analysis, Sideline Replay &amp; Recruiting Platform">
  <meta name="twitter:description" content="Film analysis, live stats, and sideline replay for competitive sports programs. Custom tagging, AI reporting, and recruiting profiles for programs at every level.">
</Fragment>
<Fragment slot="head">
  <style is:inline>
    /* ── Homepage-specific styles ── */

    /* Wider container for homepage  -  overrides styles.css default 1200px */
    .container {
      max-width: 1400px;
      padding: 0 2.5rem;
    }

    /* Hero */
    .hero {
      display: grid;
      grid-template-columns: 1fr 0.95fr;
      align-items: center;
      gap: 2.5rem;
      padding: calc(var(--nav-h) + 4.5rem) 0 2.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero-content { position: relative; z-index: 1; }


    .hero h1 {
      font-size: clamp(2.232rem, 4.65vw, 3.72rem);
      font-weight: 900;
      letter-spacing: -.04em;
      line-height: 1.08;
      margin-bottom: 1.5rem;
      color: var(--text);
    }
    .hero h1 .accent { color: var(--blue); }

    .hero-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.7;
      max-width: 520px;
      margin-bottom: 2.5rem;
    }

    .hero-image {
      position: relative;
      z-index: 1;
      aspect-ratio: 3664/2160;
      background: transparent;
      border-radius: 8px;
    }

    .hero-fade-overlay {
      position: absolute;
      inset: 0;
      background: var(--bg);
      opacity: 0;
      pointer-events: none;
      transition: opacity 1.5s ease-in-out;
      z-index: 9;
      border-radius: 8px;
    }
    .hero-fade-overlay.fading {
      opacity: 1;
    }

    .hero-endcard {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      background: var(--bg);
      opacity: 0;
      transition: opacity .5s ease-in-out;
      z-index: 10;
      border-radius: 8px;
      overflow: visible;
      padding: 2rem;
    }
    .hero-endcard.visible { display: flex; }
    .hero-endcard.fade-in { opacity: 1; }
    /* Hide the layers under the end card once it covers them, so nothing bleeds through its rounded edges */
    .hero-image:has(.hero-endcard.fade-in) .hero-fade-overlay { opacity: 0; }
    .hero-image:has(.hero-endcard.fade-in) #heroVideo { visibility: hidden; }
    .hero-endcard-mockup {
      width: 520px;
      max-width: 85%;
      height: auto;
      border-radius: 10px;
    }
    .hero-replay-btn {
      display: flex;
      align-items: center;
      gap: .45rem;
      padding: .6rem 1.4rem;
      background: #56C7FF;
      color: #0A0E1A;
      border: none;
      border-radius: 999px;
      font-size: .85rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      opacity: 1 !important;
      transition: background .2s ease;
    }
    .hero-replay-btn:hover {
      background: #3db8f5;
      opacity: 1 !important;
    }


    /* Logos strip  -  school logos marquee */
    .logos-strip {
      padding: 2.5rem 0;
      border-top: 1px solid var(--border-sub);
      border-bottom: 1px solid var(--border-sub);
      overflow: hidden;
    }
    .logos-strip-label {
      text-align: center;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 1.5rem;
    }
    .marquee-wrapper {
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    }
    .marquee-track {
      display: flex;
      align-items: center;
      gap: 48px;
      width: max-content;
      animation: marqueeScroll 65s linear infinite;
    }
    .marquee-track:hover { animation-play-state: paused; }
    @keyframes marqueeScroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .logo-cell {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    /* Baseline logo height. Some logo files have significant built-in
       canvas padding around the actual mark, so those get a taller
       override below to make the visible mark read at the same size. */
    .marquee-logo {
      height: 52px;
      width: auto;
      object-fit: contain;
      display: block;
      transition: opacity .2s;
    }
    .marquee-logo:hover { opacity: .8; }
    .marquee-logo.logo-stanford    { height: 70px; }
    .marquee-logo.logo-first-class { height: 73px; }
    .marquee-logo.logo-culver      { height: 60px; }
    .marquee-logo.logo-cornell     { height: 57px; }
    .marquee-logo.logo-denver2     { height: 63px; }
    .marquee-logo.logo-new-towson  { height: 91px; }

    /* Sports section */
    .sports-more-link { font-size: 13px; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s ease; }
    .sports-more-link:hover { color: #fff; }
    .sports-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .sport-card-basketball .sport-card-bg {
      background: linear-gradient(135deg, #1A0D00 0%, #2D1800 50%, #3D2000 100%);
    }
    .sport-card-basketball .sport-card-tag { background: rgba(255,160,60,.25); color: #FFA03C; }
    /* 16:9 by default, but taller when the text needs it. That only works while the card itself doesn't
       clip (overflow: visible), so the background layers below clip and round themselves instead. */
    .sport-card {
      position: relative;
      border-radius: var(--radius-lg);
      aspect-ratio: 16/9;
      width: 100%;
      min-width: 0; /* keep the column width; only the height may grow */
      align-self: stretch;
      display: flex;
      align-items: flex-end;
      padding: 2rem;
      text-decoration: none;
      color: #fff;
      transition: transform .3s;
    }
    .sport-card-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      border-radius: inherit;
      overflow: hidden;
    }
    .sport-card-lacrosse .sport-card-bg {
      background: linear-gradient(135deg, #0A0E1A 0%, #0F2040 50%, #1A3060 100%);
    }
    .sport-card-football .sport-card-bg {
      background-color: #111D2E;
      background-image:
        linear-gradient(rgba(86, 199, 255, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(86, 199, 255, 0.1) 1px, transparent 1px);
      background-size: 40px 20px;
    }
    .sport-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.2) 60%, transparent 100%);
      border-radius: inherit;
      z-index: 1;
    }
    .sport-card-content {
      position: relative;
      z-index: 2;
    }
    /* Keeps the first line clear of the arrow when the text fills the card (no effect when there's room) */
    .sport-card-content::before {
      content: '';
      float: right;
      width: 2.25rem;
      height: 1.75rem;
    }
    .sport-card-tag {
      display: inline-block;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: .25rem .75rem;
      border-radius: 999px;
      margin-bottom: .75rem;
    }
    .sport-card-lacrosse .sport-card-tag { background: rgba(86,199,255,.25); color: #56C7FF; }
    .sport-card-football .sport-card-tag { background: linear-gradient(135deg, var(--blue) 0%, #0080CC 100%); color: #fff; }
    .sport-card h3 {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -.02em;
      margin-bottom: .5rem;
    }
    .sport-card p {
      font-size: .9rem;
      opacity: .8;
      line-height: 1.5;
      max-width: 320px;
    }
    .sport-card-arrow {
      position: absolute;
      top: 1.5rem; right: 1.5rem;
      z-index: 2;
      width: 36px; height: 36px;
      background: rgba(255,255,255,.1);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      transition: background .2s, transform .2s;
    }
    .sport-card:hover .sport-card-arrow { background: rgba(255,255,255,.2); }

    /* Products grid */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .product-card {
      background: var(--card-bg);
      border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg);
      padding: 2rem;
      transition: background .2s, border-color .2s, transform .2s;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
    }
    .product-card:hover { border-color: var(--border); }
    .product-icon {
      width: 52px; height: 52px;
      background: var(--blue-dim);
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.25rem;
      color: var(--blue);
    }
    .product-icon svg { width: 26px; height: 26px; }
    .product-card h3 { font-size: 1.1rem; font-weight: 800; margin-bottom: .5rem; letter-spacing: -.01em; }
    .product-card p { font-size: .9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.25rem; flex: 1; }
    .product-link {
      font-size: .85rem;
      font-weight: 700;
      color: var(--blue);
      display: flex;
      align-items: center;
      gap: .35rem;
    }

    /* Purpose-built */
    .purpose-section { background: var(--bg2); }

    /* Testimonials with scroll */
    .testimonials-scroll {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    /* Testimonials carousel */
    .tc-wrap {
      position: relative;
      overflow: hidden;
    }
    .tc-track {
      display: flex;
      transition: transform .45s cubic-bezier(.4,0,.2,1);
    }
    .tc-slide {
      min-width: 100%;
      display: flex;
      justify-content: center;
    }
    .tc-slide .testimonial-card {
      max-width: 680px;
      width: 100%;
    }
    .tc-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      margin-top: 2rem;
    }
    .tc-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s, border-color .15s;
      font-size: .9rem;
      flex-shrink: 0;
    }
    .tc-btn:hover { background: var(--card-bg2); border-color: var(--border); }
    .tc-dots {
      display: flex;
      gap: .45rem;
      align-items: center;
    }
    .tc-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--border);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: background .2s, transform .2s;
    }
    .tc-dot.active {
      background: var(--blue);
      transform: scale(1.4);
    }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; min-height: auto; gap: 2.5rem; }
      .hero-image { aspect-ratio: 3664/2160; }
      .sports-grid { grid-template-columns: 1fr; }
      .products-grid { grid-template-columns: repeat(2, 1fr); }
      .testimonials-scroll { grid-template-columns: 1fr; }
    }

    @media (max-width: 600px) {
      .hero { padding-top: calc(var(--nav-h) + 3rem); }
      .hero h1 { font-size: clamp(1.767rem, 7.44vw, 2.232rem); }
      .hero-sub { font-size: 1rem; margin-bottom: 2rem; }
      .hero-endcard-mockup { width: 100%; max-width: 100%; }
      .hero-replay-btn { font-size: .85rem; padding: .55rem 1.3rem; opacity: 1; }
      /* 200px minimum height, as a spacer: a min-height on the card would stop it growing to fit its text */
      .sport-card::before { content: ''; height: calc(200px - 4rem); }
      .products-grid { grid-template-columns: 1fr; }
      .marquee-logo { height: 40px; }
      .marquee-logo.logo-stanford    { height: 54px; }
      .marquee-logo.logo-first-class { height: 56px; }
      .marquee-logo.logo-culver      { height: 46px; }
      .marquee-logo.logo-cornell     { height: 44px; }
      .marquee-logo.logo-denver2     { height: 48px; }
      .marquee-logo.logo-new-towson  { height: 70px; }
      .tc-btn { width: 44px; height: 44px; }
    }
  </style>
</Fragment>

<section style="padding: 0;">
  <div class="container">
    <div class="hero">
      <div class="hero-content">
        <h1>Powerful film analysis and sideline replay<br><span class="accent">for every level.</span></h1>
        <p class="hero-sub">Professional, easy-to-use film analysis, sideline replay, and recruiting tools built for competitive sports programs. Everything your coaching staff needs  -  in one platform.</p>
        <div class="hero-actions">
          <a href="#" class="btn btn-primary btn-lg" data-modal-open="sbContactModal">Contact Us</a>
        </div>
      </div>
      <div class="hero-image">
        <video autoplay muted playsinline id="heroVideo" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#0A0E1A;border-radius:8px;">
          <source src="website-demo8-optimized.mp4" type="video/mp4">
        </video>
        <div class="hero-fade-overlay" id="heroFadeOverlay"></div>
        <div class="hero-endcard" id="heroEndcard">
          <img src="software/final-software-mockup-basketball.png" alt="ScoreBreak Software" class="hero-endcard-mockup">
          <button class="hero-replay-btn" id="heroReplayBtn" aria-label="Replay demo">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0A0E1A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
            Replay Demo
          </button>
        </div>
      </div>
    </div>
  </div>
</section>


<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Built for your sport</h2>
    </div>
    <div class="sports-grid">
      <a href="lacrosse.html" class="sport-card sport-card-lacrosse">
        <div class="sport-card-bg"><img src="airborne-r/umd-ipad.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;"></div>
        <div class="sport-card-arrow">→</div>
        <div class="sport-card-content">
          <h3>Lacrosse</h3>
          <p>The complete end-to-end platform for lacrosse programs  -  from recruitment to game day and everything in between.</p>
        </div>
      </a>
      <a href="basketball.html" class="sport-card sport-card-basketball">
        <div class="sport-card-bg"><img src="basketball/scorebreak-basketball.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.25;"></div>
        <div class="sport-card-arrow">→</div>
        <div class="sport-card-content">
          <h3>Basketball</h3>
          <p>Film analysis, sideline replay, and officiating tools for basketball programs at every level.</p>
        </div>
      </a>
      <a href="football.html" class="sport-card sport-card-football">
        <div class="sport-card-bg"></div>

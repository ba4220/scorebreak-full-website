---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: 'Support | ScoreBreak Help Center & Customer Service',
  description: 'ScoreBreak support  -  Help Center, app downloads, and direct contact. Get help with film analysis, Airborne sideline replay, and Recruiting Network.',
  keywords: 'ScoreBreak support, ScoreBreak help, film analysis support, Airborne support, sideline replay help, ScoreBreak contact',
  ogTitle: 'Support | ScoreBreak Help Center',
  ogDescription: 'ScoreBreak support  -  Help Center, app downloads, and direct contact. We show up when it counts.',
  twitterTitle: 'Support | ScoreBreak Help Center',
  twitterDescription: 'Get help with ScoreBreak  -  film analysis, Airborne sideline replay, and Recruiting Network.',
};
---
<Layout seo={seo}>
<Fragment slot="head">
  <style is:inline>
    .support-hero {
      padding: calc(var(--nav-h) + 4.5rem) 0 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .support-hero .section-label { margin-bottom: .75rem; }
    .support-hero h1 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      font-weight: 900;
      letter-spacing: -.04em;
      line-height: 1.1;
      margin-bottom: 1rem;
    }
    .support-hero p {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 520px;
      margin: 0 auto 2.5rem;
    }
    .phone-display {
      display: inline-flex;
      align-items: center;
      gap: .75rem;
      background: var(--blue-dim);
      border: 1.5px solid var(--border);
      border-radius: 12px;
      padding: .9rem 2rem;
      font-size: 1.5rem;
      font-weight: 900;
      letter-spacing: -.02em;
      color: var(--blue);
      text-decoration: none;
      transition: background .2s, box-shadow .2s;
    }
    .phone-display:hover { border-color: var(--blue-mid); }
    .phone-display svg { width: 24px; height: 24px; }
    .phone-label {
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--blue);
      opacity: .7;
      display: block;
      margin-top: .75rem;
    }

    /* Support cards */
    .support-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      align-items: stretch;
    }
    .support-card {
      background: var(--card-bg);
      border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      text-align: center;
      transition: background .2s, border-color .2s, box-shadow .2s;
    }
    .support-card-icon {
      width: 56px; height: 56px;
      background: var(--blue-dim);
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.1rem;
      color: var(--blue);
    }
    .support-card-icon svg { width: 28px; height: 28px; }
    .support-card h3 {
      font-size: 1.1rem;
      font-weight: 800;
      margin-bottom: .45rem;
      color: var(--text);
    }
    .support-card p {
      font-size: .88rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.1rem;
    }

    /* Contact form */
    .contact-section {
      background: var(--bg2);
      border-top: 1px solid var(--border-sub);
      border-bottom: 1px solid var(--border-sub);
    }
    .contact-inner {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 5rem;
      align-items: start;
    }
    .contact-info h2 {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 900;
      letter-spacing: -.03em;
      margin-bottom: 1rem;
    }
    .contact-info p {
      font-size: .95rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 2rem;
    }
    .contact-detail {
      display: flex;
      align-items: center;
      gap: .75rem;
      margin-bottom: 1rem;
    }
    .contact-detail-icon {
      width: 36px; height: 36px;
      background: var(--blue-dim);
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      color: var(--blue);
      flex-shrink: 0;
    }
    .contact-detail-icon svg { width: 18px; height: 18px; }
    .contact-detail strong { display: block; font-size: .9rem; font-weight: 700; margin-bottom: .1rem; }
    .contact-detail span { font-size: .85rem; color: var(--text-muted); }

    .contact-form-card {
      background: var(--card-bg);
      border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
    }
    .contact-form-card h3 {
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      margin-bottom: 1rem;
    }
    .form-group label {
      font-size: .82rem;
      font-weight: 700;
      color: var(--text);
    }
    .form-group input,
    .form-group textarea {
      padding: .7rem 1rem;
      background: var(--bg);
      border: 1.5px solid var(--border-sub);
      border-radius: 10px;
      color: var(--text);
      font-size: .92rem;
      font-family: var(--font);
      transition: border-color .15s, box-shadow .15s;
    }
    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px var(--blue-dim);
    }
    .form-group textarea { resize: vertical; min-height: 120px; }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: var(--text-dim); }
    [data-theme="light"] .form-group input,
    [data-theme="light"] .form-group textarea { background: #fff; }
    .contact-submit {
      width: 100%;
      padding: .85rem;
      background: var(--blue);
      color: #0A0E1A;
      font-size: .95rem;
      font-weight: 800;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: opacity .2s;
      margin-top: .5rem;
    }
    [data-theme="light"] .contact-submit { color: #fff; }
    .contact-submit:hover { opacity: .9; }

    .contact-confirm {
      text-align: center;
      padding: 2rem 1rem;
    }
    .contact-confirm h4 { font-size: 1.2rem; font-weight: 800; margin-bottom: .75rem; color: var(--blue); }
    .contact-confirm p { font-size: .9rem; color: var(--text-muted); line-height: 1.6; }

    @media (max-width: 900px) {
      .support-cards { grid-template-columns: 1fr; max-width: 440px; margin-left: auto; margin-right: auto; }
      .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; }
      .contact-form-card { padding: 2rem 1.5rem; }
    }

    @media (max-width: 600px) {
      .support-hero { padding: calc(var(--nav-h) + 2.5rem) 0 0; }
      .support-hero h1 { font-size: clamp(1.7rem, 8vw, 2.2rem); }
      .phone-display { padding: .8rem 1.5rem; font-size: 1.2rem; }
      .support-card { padding: 1.5rem 1.25rem; }
      .contact-form-card { padding: 1.5rem 1.25rem; }
    }
  </style>
</Fragment>

<section class="support-hero">
  <div class="container">
    <h1>Support That Shows Up<br>When It Counts.</h1>
    <p>Get the help you need, fast. From comprehensive documentation to live support  -  we're here for your program.</p>
    <div>
      <a href="tel:18008092102" class="phone-display">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.5 9.37 19.79 19.79 0 01.43 .74 2 2 0 012.42.5h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 8.18a16 16 0 006.29 6.29l1.02-.92a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        1.800.809.2102
      </a>
    </div>
  </div>
</section>

<!-- SUPPORT SECTIONS -->
<section class="section">
  <div class="container">
    <div class="support-cards">
      <!-- Help Center -->
      <div class="support-card">
        <div class="support-card-icon">
          <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 18v-5C4 8.5 8.5 4 14 4s10 4.5 10 9v5"/>
            <rect x="2" y="17" width="5" height="6" rx="2"/>
            <rect x="21" y="17" width="5" height="6" rx="2"/>
          </svg>
        </div>
        <h3>Help Center</h3>
        <p>Explore our comprehensive documentation, tutorials, and guides to get the most out of ScoreBreak.</p>
        <a href="https://intercom.help/scorebreakhelp/en/" class="btn btn-outline btn-sm" target="_blank" rel="noopener" style="margin: 0 auto;">Visit Help Center →</a>
      </div>

      <!-- Downloads -->
      <div class="support-card">
        <div class="support-card-icon">
          <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 16v4a2 2 0 002 2h16a2 2 0 002-2v-4"/>
            <polyline points="8 12 14 18 20 12"/>
            <line x1="14" y1="2" x2="14" y2="18"/>
          </svg>
        </div>
        <h3>Downloads</h3>
        <p>Download ScoreBreak for Mac, iPhone, and iPad — or open the web app directly in your browser.</p>
        <div style="display:flex; flex-direction:column; align-items:center; gap:.6rem; margin-top:.5rem;">
          <a href="https://apps.apple.com/us/app/scorebreak-game-film-review/id1047466750" target="_blank" rel="noopener" aria-label="Download on the App Store">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" style="height:44px; width:auto; display:block;">
          </a>
          <a href="https://app.scorebreak.io" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Open Web App →</a>
        </div>
      </div>

      <!-- Contact -->
      <div class="support-card" style="text-align:left">
        <div class="support-card-icon" style="margin-left:0;">
          <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
        </div>
        <h3>Contact Support</h3>
        <p>Can't find what you're looking for? Send us a message and we'll respond within 1 business day.</p>
        <div style="margin-top: .25rem;">
          <div class="contact-detail">
            <div class="contact-detail-icon">
              <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h12a1 1 0 011 1v9a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1z"/><path d="M16 5L9 10 2 5"/></svg>
            </div>
            <div>
              <strong>Email</strong>
              <span>support@scorebreak.io</span>
            </div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-icon">
              <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.5 13.4v2.2a1.5 1.5 0 01-1.6 1.5 14.8 14.8 0 01-6.5-2.3 14.6 14.6 0 01-4.5-4.5A14.8 14.8 0 011.6 3.6 1.5 1.5 0 013 2.1h2.2a1.5 1.5 0 011.5 1.3c.1.9.3 1.8.6 2.6a1.5 1.5 0 01-.3 1.6L6 8.6a12 12 0 004.7 4.7l.9-.9a1.5 1.5 0 011.6-.3c.8.3 1.7.5 2.6.6a1.5 1.5 0 011.3 1.5l-.1.2z"/></svg>
            </div>
            <div>
              <strong>Phone</strong>
              <span>1.800.809.2102</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT FORM SECTION -->
<section class="section contact-section">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-info">
        <div class="section-label">Send a Message</div>
        <h2>We're here to help</h2>
        <p>Our support team understands there's no time for downtime. We prioritize ScoreBreak users with faster response times and direct access to our technical experts.</p>
        <div class="contact-detail">
          <div class="contact-detail-icon">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="7"/><path d="M9 5v4l3 2"/></svg>
          </div>
          <div>
            <strong>Response Time</strong>
            <span>Within 1 business day</span>
          </div>
        </div>
        <div class="contact-detail">
          <div class="contact-detail-icon">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9l4 4 6-7"/></svg>
          </div>
          <div>
            <strong>Priority Support</strong>
            <span>All ScoreBreak subscribers get priority queue</span>
          </div>
        </div>
        <div class="contact-detail">
          <div class="contact-detail-icon">
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 1l2.3 4.6L17 6.5l-4 3.9.9 5.5L9 13.5l-4.9 2.4.9-5.5-4-3.9 5.7-.9L9 1z"/></svg>
          </div>
          <div>
            <strong>Technical Experts</strong>
            <span>Direct access to people who built the product</span>
          </div>
        </div>
      </div>

      <div class="contact-form-card">
        <h3>Send us a message</h3>
        <form id="contactForm" novalidate data-form="support-request" data-form-confirm="#contactConfirm">
          <p class="sb-hidden-field"><label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
          <div class="form-group">
            <label for="cName">Your Name</label>
            <input type="text" id="cName" name="name" placeholder="Jane Smith" required />
          </div>
          <div class="form-group">
            <label for="cEmail">Email Address</label>
            <input type="email" id="cEmail" name="email" placeholder="jane@school.edu" required />
          </div>
          <div class="form-group">
            <label for="cMessage">Message</label>
            <textarea id="cMessage" name="message" placeholder="Describe the issue or question..." required></textarea>
          </div>
          <button type="submit" class="contact-submit">Send Message →</button>
        </form>
        <div class="contact-confirm" id="contactConfirm" hidden>
          <h4>Message sent!</h4>
          <p>Thanks for reaching out. Our support team will get back to you within 1 business day.</p>
        </div>
      </div>
    </div>
  </div>
</section>

</Layout>

---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: 'ScoreBreak for Soccer, Hockey & More | Film Analysis for Any Sport',
  description: 'ScoreBreak\'s professional film analysis platform works for soccer, ice hockey, field hockey, and more. The same tools used by elite programs — built for any coaching staff.',
  keywords: 'soccer film analysis, ice hockey video analysis, field hockey coaching software, sports film analysis platform, coaching video software, ScoreBreak',
  ogTitle: 'ScoreBreak for Other Sports | Film Analysis for Any Sport',
  ogDescription: 'Professional film analysis and collaboration tools built for any coaching staff, any sport.',
};
---
<Layout seo={seo}>
<Fragment slot="head">
  <style is:inline>
    /* ── Other Sports page-specific styles ── */

    /* Hero */
    .os-hero {
      position: relative;
      min-height: 75vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: calc(var(--nav-h) + 4rem) 0 4rem;
    }
    .os-hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .os-hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
    }
    .os-hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(8,10,14,.88) 0%,
        rgba(8,10,14,.70) 50%,
        rgba(8,10,14,.30) 100%
      );
    }
    [data-theme="light"] .os-hero-bg::after {
      background: linear-gradient(
        to right,
        rgba(240,242,246,.90) 0%,
        rgba(240,242,246,.72) 50%,
        rgba(240,242,246,.25) 100%
      );
    }
    .os-hero-content {
      position: relative;
      z-index: 1;
      max-width: 640px;
    }
    .os-hero h1 {
      font-size: clamp(2.6rem, 5.5vw, 4.4rem);
      font-weight: 900;
      letter-spacing: -.04em;
      line-height: 1.07;
      margin-bottom: 1.4rem;
      color: var(--text);
    }
    .os-hero .hero-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 2.2rem;
      max-width: 540px;
    }
    .os-hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    /* Sport Cards */
    .sport-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .os-sport-card {
      background: var(--card-bg);
      border: 1px solid var(--border-sub);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color .2s, box-shadow .2s, transform .2s;
    }
    .os-sport-card-img {
      width: 100%;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      position: relative;
      background: var(--card-bg2);
    }
    .os-sport-card-img img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .4s ease;
    }
    .os-sport-card-body {
      padding: 1.1rem 1.5rem;
    }
    .os-sport-card-name {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -.02em;
    }

    /* Feature Cards */
    .os-features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .os-feature-card {
      background: var(--card-bg);
      border: 1px solid var(--border-sub);
      border-radius: 12px;
      padding: 1.75rem;
      transition: border-color .2s, background .2s;
    }
    .os-feature-card:hover {
      background: var(--card-bg2);
      border-color: var(--border);
    }
    .os-feature-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--blue-dim);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.1rem;
      color: var(--blue);
    }
    .os-feature-icon svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
    }
    .os-feature-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: .5rem;
      letter-spacing: -.01em;
    }
    .os-feature-desc {
      font-size: .9rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin: 0;
    }

    /* Airborne callout */
    .os-airborne {
      background: var(--card-bg);
      border: 1px solid var(--border-sub);
      border-radius: 16px;
      padding: 3.5rem;
      display: flex;
      align-items: center;
      gap: 3rem;
    }
    .os-airborne-text { flex: 1; }
    .os-airborne-badge {
      display: inline-block;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 1.1rem;
    }
    .os-airborne h2 {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 800;
      letter-spacing: -.03em;
      line-height: 1.15;
      margin-bottom: 1rem;
      color: var(--text);
    }
    .os-airborne p {
      font-size: .98rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }
    .os-airborne-visual {
      flex: 0 0 300px;
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, #0d1a2e 0%, #0a2040 60%, #051525 100%);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(86,199,255,.15);
    }
    .os-airborne-visual::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 60% 40%, rgba(86,199,255,.12) 0%, transparent 70%);
    }
    .os-airborne-logo {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
    }
    .os-airborne-logo img {
      height: 48px;
      width: auto;
      opacity: .85;
    }

    /* CTA section */
    .os-cta {
      text-align: center;
    }
    .os-cta h2 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      font-weight: 900;
      letter-spacing: -.04em;
      line-height: 1.1;
      margin-bottom: 1rem;
      color: var(--text);
    }
    .os-cta p {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 540px;
      margin: 0 auto 2.2rem;
      line-height: 1.7;
    }
    .os-cta-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* Section badge shared */
    .os-badge {
      display: inline-block;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 1.1rem;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .sport-cards-grid { grid-template-columns: repeat(2, 1fr); }
      .os-features-grid { grid-template-columns: repeat(2, 1fr); }
      .os-airborne { flex-direction: column; gap: 2rem; }
      .os-airborne-visual { flex: none; width: 100%; aspect-ratio: 16/7; }
    }
    @media (max-width: 600px) {
      .os-hero h1 { font-size: clamp(2rem, 8vw, 2.6rem); }
      .sport-cards-grid { grid-template-columns: 1fr; }
      .os-features-grid { grid-template-columns: 1fr; }
      .os-hero { min-height: 80vh; }
      .os-hero-actions { flex-direction: column; align-items: stretch; }
      .os-hero-actions .btn { width: 100%; justify-content: center; }
      .os-cta-actions { flex-direction: column; align-items: stretch; }
      .os-cta-actions .btn { width: 100%; justify-content: center; }
      .os-airborne { padding: 2rem 1.5rem; }
    }
  </style>
</Fragment>

<section class="os-hero">
  <div class="os-hero-bg">
    <img src="https://images.pexels.com/photos/1884574/pexels-photo-1884574.jpeg" alt="Soccer stadium" loading="lazy">
  </div>
  <div class="container">
    <div class="os-hero-content">
      <h1>ScoreBreak works for your sport.</h1>
      <p class="hero-sub">The same professional film analysis and collaboration tools used by lacrosse and basketball programs — built to work for any coaching staff, any sport.</p>
      <div class="os-hero-actions">
        <a href="#" class="btn btn-primary btn-lg" data-modal-open="sbContactModal">Contact Us</a>
        <a href="/demo/" class="btn btn-outline btn-lg">Request a Demo</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SPORTS INTRO ═══ -->
<section class="section">
  <div class="container">
    <div class="sport-cards-grid">

      <!-- Soccer -->
      <div class="os-sport-card">
        <div class="os-sport-card-img">
          <img src="/soccer.jpg" alt="Soccer match aerial view" loading="lazy">
        </div>
        <div class="os-sport-card-body">
          <div class="os-sport-card-name">Soccer</div>
        </div>
      </div>

      <!-- Ice Hockey -->
      <div class="os-sport-card">
        <div class="os-sport-card-img">
          <img src="/ice-hockey.jpg" alt="Ice hockey player on the rink" loading="lazy">
        </div>
        <div class="os-sport-card-body">
          <div class="os-sport-card-name">Ice Hockey</div>
        </div>
      </div>

      <!-- Field Hockey -->
      <div class="os-sport-card">
        <div class="os-sport-card-img">
          <img src="/field-hockey.jpg" alt="Field hockey player in action" loading="lazy">
        </div>
        <div class="os-sport-card-body">
          <div class="os-sport-card-name">Field Hockey</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══ FEATURES ═══ -->
<section class="section" style="background: var(--bg2);">
  <div class="container">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <div class="os-badge">What's Included</div>
      <h2 class="section-title">Everything your staff needs.</h2>
      <p class="section-subtitle" style="max-width:580px; margin:0 auto;">ScoreBreak is built to fit your system, your terminology, and your workflow.</p>
    </div>

    <div class="os-features-grid">

      <div class="os-feature-card">
        <div class="os-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
        </div>
        <div class="os-feature-title">Custom Tagging Workflows</div>
        <p class="os-feature-desc">Build a tagging system around your sport's terminology and your coaching style. Each coach on staff can have their own custom layout.</p>
      </div>

      <div class="os-feature-card">
        <div class="os-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/><path d="M3 7l9 6 9-6"/></svg>
        </div>
        <div class="os-feature-title">Unlimited Cloud Storage</div>
        <p class="os-feature-desc">Every game, every practice, every season — stored and accessible forever. No storage limits, no purging old film.</p>
      </div>

      <div class="os-feature-card">
        <div class="os-feature-icon">
          <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        </div>
        <div class="os-feature-title">Playlists &amp; Presentations</div>
        <p class="os-feature-desc">Combine film clips, whiteboard drawings, and coaching notes into a single presentation for your team or individual players.</p>
      </div>

      <div class="os-feature-card">
        <div class="os-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <div class="os-feature-title">Team Collaboration</div>
        <p class="os-feature-desc">Share clips and game plans with your entire staff instantly. Built-in chat means feedback happens inside the platform — no switching apps.</p>
      </div>

      <div class="os-feature-card">
        <div class="os-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/></svg>
        </div>
        <div class="os-feature-title">Remote Film Sessions</div>
        <p class="os-feature-desc">Run live film sessions with your whole team from anywhere — a Zoom-like experience built directly into ScoreBreak.</p>
      </div>

      <div class="os-feature-card">
        <div class="os-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        </div>
        <div class="os-feature-title">Offline Viewing</div>
        <p class="os-feature-desc">Download film to your device and review without an internet connection. Perfect for travel and away games.</p>
      </div>

    </div>
  </div>
</section>

<!-- ═══ AIRBORNE ═══ -->
<section class="section">
  <div class="container">
    <div class="os-airborne">
      <div class="os-airborne-text">
        <div class="os-airborne-badge">Sideline Replay</div>
        <h2>Add sideline replay to any sport.</h2>
        <p>Airborne R is a portable, battery-powered sideline replay system that works at any venue — no installation required. Set up in minutes, get instant replay on the sideline.</p>
        <a href="/airborne/" class="btn btn-outline">Learn About Airborne →</a>
      </div>
      <div class="os-airborne-visual">
        <img src="/airborne-r/airborne-locker-room.png" alt="Airborne R sideline replay system in locker room" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:12px;" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="section" style="padding: 2.5rem 0;">
  <div class="container">
    <div class="os-cta">
      <h2>ScoreBreak works for your sport.</h2>
      <p>If your staff reviews film and prepares for opponents, ScoreBreak has the tools to make that process faster and more effective.</p>
      <div class="os-cta-actions">
        <a href="#" class="btn btn-primary btn-lg" data-modal-open="sbContactModal">Contact Us</a>
        <a href="/demo/" class="btn btn-outline btn-lg">Request a Demo</a>
      </div>
    </div>
  </div>
</section>

</Layout>

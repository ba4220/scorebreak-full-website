---
// Every page: shared head, nav, footer, contact modal and site scripts.
// Slots: "meta" (title + meta tags), "head" (page <style>s, after the shared stylesheets),
// default (page content), "modals" (page modals, after the contact modal).
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import stylesHref from '../styles/styles.css?url';
import componentsHref from '../styles/components.css?url';

interface Props {
  // football.astro skips styles.css; its own styles conflict with it.
  sharedStyles?: boolean;
}
const { sharedStyles = true } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <slot name="meta" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  {sharedStyles && <link rel="stylesheet" href={stylesHref} />}
  <link rel="stylesheet" href={componentsHref} />
  <slot name="head" />
</head>
<body>

<Nav />

<slot />

<Footer />

<ContactModal />

<slot name="modals" />

<script>import '../scripts/site';</script>
</body>
</html>
